# Copy to .env.local. In dev the app uses the emulators unless VITE_USE_EMULATORS=false.
VITE_USE_EMULATORS=true

# Real project (only needed when not using emulators / for production builds)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-apbites
VITE_FIREBASE_APP_ID=
